// Cloudflare Worker that relays EVE resource files to the site with the
// cross-origin headers browsers require, and hosts duel rooms for players
// whose browsers cannot connect to each other directly. Deployed by Cloudflare on every push
// (Workers Builds, root directory: worker). The name must match the Worker's
// name in the Cloudflare dashboard.
{
  "name": "eve-p2p-res",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Served from the free workers.dev address; no per-branch preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  // Duel rooms for players who cannot connect directly: one small object per room code.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Sites allowed to load files through this relay, comma separated.
    "ALLOWED_ORIGINS": "https://orexx1.github.io,http://localhost:5173,http://localhost:4173",
    // Where the resource index shards are published (built by the site's deploy).
    "INDEX_URL": "https://orexx1.github.io/EVE-P2P/ri/"
  }
}
