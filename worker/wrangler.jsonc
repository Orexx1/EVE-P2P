// Cloudflare Worker that relays EVE resource files to the site with the
// cross-origin headers browsers require. Deployed by Cloudflare on every push
// (Workers Builds, root directory: worker). The name must match the Worker's
// name in the Cloudflare dashboard.
{
  "name": "eve-p2p-res",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    // Sites allowed to load files through this relay, comma separated.
    "ALLOWED_ORIGINS": "https://orexx1.github.io,http://localhost:5173,http://localhost:4173"
  }
}
